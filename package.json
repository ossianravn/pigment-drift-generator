{
  "name": "pigment-drift-generator",
  "version": "0.1.0",
  "private": true,
  "description": "Generate still and moving watercolor 'pigment drift' backgrounds for websites, then export them as images, looping video or a tiny live WebGL embed.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ossianravn/pigment-drift-generator.git"
  },
  "scripts": {
    "dev": "npm run build:embed && vite",
    "build:embed": "vite build --config vite.embed.config.ts",
    "build": "npm run build:embed && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "mediabunny": "^1.61.1"
  }
}
